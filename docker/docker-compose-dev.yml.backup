name: pm_back_dev
services:
  app:
    build:
      context: ..
      dockerfile: docker/dockerfile.dev # Ligamos el dockerfile personalizado para dev
    ports:
      - "3015:3015" # Mapea el puerto del contenedor al de tu máquina
    volumes:
      - ../:/app # Mapea el código fuente para obtener los archivos fuente y reflejar cambios en tiempo real
    env_file:
      - ../.env.development # Archivo con las variables de entorno
    depends_on:
      - ldap
  ldap:
    image: osixia/openldap:1.5.0
    container_name: pm_ldap
    environment:
      LDAP_ORGANISATION: "Example Corp"
      LDAP_DOMAIN: "example.com"
      LDAP_ADMIN_PASSWORD: "adminpassword"
      LDAP_TLS: "false"
    ports:
      - "389:389"
    volumes:
      - ldap_data:/var/lib/ldap
      - ldap_config:/etc/ldap/slapd.d
    command: --copy-service

volumes:
  ldap_data:
  ldap_config:
